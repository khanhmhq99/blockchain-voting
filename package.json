{
  "name": "blockchain-voting",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "blockchain:compile": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat compile --config blockchain/hardhat.config.ts",
    "blockchain:test": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat test --config blockchain/hardhat.config.ts",
    "blockchain:node": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat node --config blockchain/hardhat.config.ts",
    "blockchain:deploy:local": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat run blockchain/scripts/deploy.ts --network localhost --config blockchain/hardhat.config.ts",
    "blockchain:deploy:testnet": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat run blockchain/scripts/deploy.ts --network bscTestnet --config blockchain/hardhat.config.ts",
    "blockchain:grant-organizer:local": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat run blockchain/scripts/grant-organizer.ts --network localhost --config blockchain/hardhat.config.ts",
    "blockchain:grant-organizer:testnet": "cross-env TS_NODE_PROJECT=blockchain/tsconfig.json hardhat run blockchain/scripts/grant-organizer.ts --network bscTestnet --config blockchain/hardhat.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@openzeppelin/contracts": "5.6.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.15.0",
    "lucide-react": "^0.545.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.3.8",
    "hardhat": "^2.26.3",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "solidity-coverage": "^0.8.16",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for receipt synchronization and administrative setup.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser-safe chain settings (BSC testnet defaults shown)
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_VOTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.bscscan.com

# Server/deployment only. Never prefix this with NEXT_PUBLIC_.
DEPLOYER_PRIVATE_KEY=
ORGANIZER_ADDRESS=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Optional for local contract deployment metadata
LOCALHOST_RPC_URL=http://127.0.0.1:8545
